# Afya Jamii AI — backend configuration
#
# Copy this file to `.env` and fill in the values marked REQUIRED.
# `.env` is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------

# ── Application ────────────────────────────────────────────────────────────
# One of: development | staging | production
ENVIRONMENT=development

# DEBUG and RELOAD must both be false when ENVIRONMENT=production.
DEBUG=true
RELOAD=true

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# `text` for local development, `json` when shipping to a log aggregator.
LOG_FORMAT=text

# ── Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Security ───────────────────────────────────────────────────────────────
# REQUIRED. At least 32 characters, stable across restarts and workers —
# changing it invalidates every issued token. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
BCRYPT_ROUNDS=12

# Hostnames this API will answer to, comma-separated.
# `*` is rejected in production — list the real hostnames there.
ALLOWED_HOSTS=*

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call this API. Must be explicit in
# production; a wildcard cannot be combined with credentialed requests.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ── Database (MySQL) ───────────────────────────────────────────────────────
# Either set DATABASE_URL directly...
# DATABASE_URL=mysql+pymysql://user:password@host:3306/afya_jamii
# ...or leave it unset and provide the parts below.
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=afya_jamii
DATABASE_USER=afya_jamii
DB_PASSWORD=

# Connection pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Transport security for the database connection.
#   verify   encrypted, certificate checked against DB_SSL_CA (strongest)
#   require  encrypted, certificate not checked (default)
#   disable  plaintext — a local database only
#
# A managed MySQL reached over the internet will accept an unencrypted
# connection unless the client asks for TLS, so the default is `require`
# rather than `disable`. Providers that sign with their own CA (Aiven among
# them) need that CA file before `verify` can succeed — download it from the
# service page and point DB_SSL_CA at it.
DB_SSL_MODE=require
# DB_SSL_CA=./certs/aiven-ca.pem

# ── Machine learning model ─────────────────────────────────────────────────
# Relative paths are resolved against the backend root, not the working
# directory, so these work under uvicorn, Docker, and systemd alike.
MODEL_PATH=./data/risk_model_v1.pkl
LABEL_ENCODER_PATH=./data/risk_label_encoder.pkl

# ── Language model (Groq) ──────────────────────────────────────────────────
# REQUIRED. Get a key from https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# The model serving clinical advice. Swap this without touching any code.
LLM_MODEL_NAME=openai/gpt-oss-120b

# 0.0 is fully deterministic; a little warmth reads less robotic.
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# ── Prompts ────────────────────────────────────────────────────────────────
# Prompt templates live in JSON files, not in the source. Leave PROMPT_DIR
# empty to use the bundled `app/prompts` directory, or point it elsewhere to
# override prompts per environment without redeploying.
# PROMPT_DIR=/etc/afya-jamii/prompts
PROMPT_NAME=clinical_assistant

# Re-read the prompt file when it changes on disk. Handy while editing wording;
# leave false in production so the template is read once.
PROMPT_RELOAD_ON_CHANGE=false

# How many past turns to replay to the model as conversation history.
CHAT_HISTORY_TURNS=10

# Size limits on that replayed history. The model's answers run to several
# thousand characters, so without these the prompt grows with every exchange
# and each question takes longer than the one before it. Past replies are
# condensed to CHAT_HISTORY_REPLY_CHARS, and turns are admitted newest-first
# until CHAT_HISTORY_CHAR_BUDGET is spent.
CHAT_HISTORY_CHAR_BUDGET=6000
CHAT_HISTORY_REPLY_CHARS=700

# ── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_SIGNUP=10/minute
RATE_LIMIT_INFERENCE=20/minute

# ── Error reporting (optional) ─────────────────────────────────────────────
# SENTRY_DSN=
